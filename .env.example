# Cle API eSante : necessaire uniquement pour relancer l'extraction (scraping/)
ESANTE_API_KEY=PUT_YOUR_API_KEY_HERE

# MongoDB Atlas : suivi des sites visites dans l'interface web (optionnel)
# Exemple : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=

# CARTO : fond de carte clair "Positron" (optionnel). Cle gratuite sur
# https://carto.com/basemaps/apikey (connexion par e-mail). Sans cle, la carte
# utilise les tuiles OpenStreetMap.
CARTO_API_KEY=
